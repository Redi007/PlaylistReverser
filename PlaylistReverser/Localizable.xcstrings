{
  "sourceLanguage": "en",
  "strings": {
    "%@ (Backup)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Backup)"
          }
        }
      }
    },
    "%@ Automatic restore failed. Your original order is fully preserved in the backup playlist – please do not delete it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Die automatische Wiederherstellung ist fehlgeschlagen. Deine ursprüngliche Reihenfolge ist vollständig in der Backup-Playlist gesichert – bitte nicht löschen."
          }
        }
      }
    },
    "%@ The original playlist was restored to its previous order from the backup and verified. The backup has been kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Die Originalplaylist wurde aus dem Backup in ihre alte Reihenfolge zurückgeschrieben und geprüft. Das Backup bleibt bestehen."
          }
        }
      }
    },
    "%@: expected %lld songs, found %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: erwartet %2$lld Titel, gefunden %3$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: expected %2$lld songs, found %3$lld."
          }
        }
      }
    },
    "%@: mismatch at position %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Abweichung an Position %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: mismatch at position %2$lld."
          }
        }
      }
    },
    "%lld of %lld songs copied": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Titeln kopiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld songs copied"
          }
        }
      }
    },
    "%lld songs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Titel"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld song"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld songs"
                }
              }
            }
          }
        }
      }
    },
    "A playlist with the backup name already exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es existiert bereits eine Playlist mit dem Backup-Namen."
          }
        }
      }
    },
    "About Playlist Reverser": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Playlist Reverser"
          }
        }
      }
    },
    "An error occurred while reordering.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Neuordnen ist ein Fehler aufgetreten."
          }
        }
      }
    },
    "An error occurred while reordering: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Neuordnen ist ein Fehler aufgetreten: %@"
          }
        }
      }
    },
    "Artwork of the original playlist was copied.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover der Originalplaylist übernommen."
          }
        }
      }
    },
    "Backup": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        }
      }
    },
    "Backup and new order verified": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup und neue Reihenfolge geprüft"
          }
        }
      }
    },
    "Backup name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup-Name"
          }
        }
      }
    },
    "Backup “%@” was created in the original order and verified.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup „%@“ in der ursprünglichen Reihenfolge angelegt und geprüft."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Choose a playlist on the left to preview it in reverse. Nothing is saved to Music until you confirm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle links eine Playlist, um eine umgekehrte Vorschau zu sehen. In Musik wird erst nach deiner Bestätigung etwas gespeichert."
          }
        }
      }
    },
    "Couldn’t Load Playlists": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlists konnten nicht geladen werden"
          }
        }
      }
    },
    "Create a new playlist in Music?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Playlist in Musik anlegen?"
          }
        }
      }
    },
    "Creating backup: %lld of %lld songs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup wird angelegt: %1$lld von %2$lld Titeln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Creating backup: %1$lld of %2$lld songs"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Enter a name for the backup playlist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Namen für die Backup-Playlist ein."
          }
        }
      }
    },
    "Enter a name for the new playlist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Namen für die neue Playlist ein."
          }
        }
      }
    },
    "Expected %lld songs, found %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwartet: %1$lld Titel, gefunden: %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Expected %1$lld songs, found %2$lld."
          }
        }
      }
    },
    "First, the backup “%@” is created in the current order and verified.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst wird das Backup „%@“ in der aktuellen Reihenfolge angelegt und geprüft."
          }
        }
      }
    },
    "I understand that the original playlist will be changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe, dass die Originalplaylist verändert wird."
          }
        }
      }
    },
    "If anything fails, the previous order is restored from the backup automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einem Fehler wird die alte Reihenfolge automatisch aus dem Backup wiederhergestellt."
          }
        }
      }
    },
    "Loading Playlists…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlists werden geladen …"
          }
        }
      }
    },
    "Mismatch at position %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abweichung an Position %lld."
          }
        }
      }
    },
    "Music did not respond in time. Make sure Music is not busy (for example with a dialog or a library update) and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Musik-App hat nicht rechtzeitig geantwortet. Stelle sicher, dass Musik nicht beschäftigt ist (z. B. mit einem Dialog oder einer Mediathek-Aktualisierung), und versuche es erneut."
          }
        }
      }
    },
    "Music does not expose playlist artwork via scripting. Shown is the automatic album mosaic, which Music also generates for the copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Musik-App gibt Playlist-Cover nicht per Skript heraus. Gezeigt wird das automatische Album-Mosaik, das Musik auch für die Kopie erzeugt."
          }
        }
      }
    },
    "Music reported an error (%lld): %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Musik-App meldete einen Fehler (%1$lld): %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Music reported an error (%1$lld): %2$@"
          }
        }
      }
    },
    "Music will give the copy an automatic cover.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie erhält von der Musik-App ein automatisches Cover."
          }
        }
      }
    },
    "Name of the new playlist – click to edit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name der neuen Playlist – zum Bearbeiten klicken"
          }
        }
      }
    },
    "New Copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Kopie"
          }
        }
      }
    },
    "No Access to Music": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf Musik"
          }
        }
      }
