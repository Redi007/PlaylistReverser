          }
        }
      }
    },
    "Restore Original Order": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalreihenfolge"
          }
        }
      }
    },
    "Reverse Order": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihenfolge umkehren"
          }
        }
      }
    },
    "Reverse the order first to reorder the original playlist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehre zuerst die Reihenfolge um, um die Originalplaylist neu zu ordnen."
          }
        }
      }
    },
    "Reversed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgekehrt"
          }
        }
      }
    },
    "Save Now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt speichern"
          }
        }
      }
    },
    "Save as": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern als"
          }
        }
      }
    },
    "Save to Music…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Musik speichern …"
          }
        }
      }
    },
    "Saving Playlist": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist wird gespeichert"
          }
        }
      }
    },
    "Search Playlists": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlists suchen"
          }
        }
      }
    },
    "Select a Playlist": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist auswählen"
          }
        }
      }
    },
    "Shared playlists change for everyone who has access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteilte Playlists ändern sich für alle Beteiligten."
          }
        }
      }
    },
    "Show in Music": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Musik zeigen"
          }
        }
      }
    },
    "Smart playlist – can only be saved as a copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligente Playlist – kann nur als Kopie gespeichert werden"
          }
        }
      }
    },
    "Smart playlists can only be saved as a new copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligente Playlists können nur als neue Kopie gespeichert werden."
          }
        }
      }
    },
    "Smart playlists cannot be reordered.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligente Playlists können nicht neu geordnet werden."
          }
        }
      }
    },
    "Something Went Wrong": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fehler ist aufgetreten"
          }
        }
      }
    },
    "The Original Playlist Will Be Changed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originalplaylist wird verändert"
          }
        }
      }
    },
    "The artwork stays with the original playlist (this cannot be verified by the app – please check in Music). The backup gets an automatic cover.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Cover bleibt an der Originalplaylist (technisch nicht prüfbar – bitte in Musik kontrollieren). Das Backup erhält ein automatisches Cover."
          }
        }
      }
    },
    "The artwork stays with the original, but the app cannot verify this.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Cover bleibt am Original; ob es erhalten bleibt, kann die App nicht prüfen."
          }
        }
      }
    },
    "The custom artwork could not be copied – Music does not allow setting playlist artwork via scripting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das eigene Cover konnte nicht übernommen werden – die Musik-App erlaubt das Setzen von Playlist-Covern per Skript nicht."
          }
        }
      }
    },
    "The operation was cancelled. The partial copy was removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang wurde abgebrochen. Die angelegte Teilkopie wurde wieder entfernt."
          }
        }
      }
    },
    "The original artwork is shown for reference only. Music does not allow setting playlist artwork via scripting, so the copy gets an automatic cover.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original-Cover wird nur angezeigt. Die Musik-App erlaubt das Setzen von Playlist-Covern per Skript nicht; die Kopie erhält ein automatisches Cover."
          }
        }
      }
    },
    "The original playlist has changed since it was loaded. Nothing was saved. Please reload the playlist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originalplaylist hat sich seit dem Laden geändert. Es wurde nichts gespeichert. Bitte lade die Playlist neu."
          }
        }
      }
    },
    "The original playlist is being rewritten. This step can’t be cancelled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originalplaylist wird neu geschrieben. Dieser Schritt kann nicht abgebrochen werden."
          }
        }
      }
    },
    "The original playlist was changed while saving.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originalplaylist wurde während des Speicherns verändert."
          }
        }
      }
    },
    "The playlist or one of its songs could not be found in Music. It may have been deleted or changed. Reload and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Playlist oder einer ihrer Titel wurde in Musik nicht gefunden. Möglicherweise wurde sie gelöscht oder geändert. Lade neu und versuche es erneut."
          }
        }
      }
    },
    "The script could not be created.": {
