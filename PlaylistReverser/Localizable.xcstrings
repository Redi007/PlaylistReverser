      }
    },
    "Original Order": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalreihenfolge"
          }
        }
      }
    },
    "Original playlist unchanged": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalplaylist unverändert"
          }
        }
      }
