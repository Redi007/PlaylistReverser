    "Playlist Name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist-Name"
          }
        }
      }
    },
    "Playlist Reordered": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist neu geordnet"
          }
        }
      }
    },
    "Playlist Reverser": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist Reverser"
          }
        }
      }
    },
    "Playlist Reverser is not allowed to control Music. Allow access under System Settings › Privacy & Security › Automation › Playlist Reverser › Music.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist Reverser darf die Musik-App nicht steuern. Erlaube den Zugriff unter Systemeinstellungen › Datenschutz & Sicherheit › Automation › Playlist Reverser › Musik."
          }
        }
      }
    },
    "Playlist Saved": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist gespeichert"
          }
        }
      }
    },
    "Playlist artwork stays with the original playlist; the backup gets an automatic cover.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist-Cover bleiben an der Originalplaylist; das Backup erhält ein automatisches Cover."
